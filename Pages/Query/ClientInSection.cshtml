@page
@model QueryClientInSectionModel
@{
    ViewData["Title"] = "???? ?? ???";
}
<div class="container mt-3">
    <h3>????? ???? ???? ???</h3>

    <form method="get" id="queryGetForm" class="row g-2 align-items-end">
        <div class="col-auto">
            <label class="form-label">?????</label>
            <select id="sectionSelect" name="SectionId" class="form-select">
                <option value="">-- ???? ????? --</option>
                @foreach(var s in Model.Sections)
                {
                    <option value="@s.Value" selected="@(Model.SectionId.HasValue && Model.SectionId.Value.ToString() == s.Value ? "selected" : null)">@s.Text</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label">??????</label>
            <select id="clientSelect" name="ClientId" class="form-select">
                <option value="">-- ???? ?????? --</option>
                @foreach(var c in Model.Clients)
                {
                    <option value="@c.Value" selected="@(Model.ClientId.HasValue && Model.ClientId.Value.ToString() == c.Value ? "selected" : null)">@c.Text</option>
                }
            </select>
        </div>
        <div class="col-auto d-flex gap-2">
            <button type="submit" class="btn btn-primary">????</button>
            <button type="button" class="btn btn-outline-success" id="executeControllerBtn">???? ??????</button>
        </div>
        <div class="col-12 mt-2">
            <div asp-validation-summary="All" class="text-danger"></div>
        </div>
    </form>

    @if (Model.HasResult)
    {
        <div class="card mt-3 p-3">
            <div>SectionId: <strong>@Model.Result.SectionId</strong></div>
            <div>ClientId: <strong>@Model.Result.ClientId</strong></div>
            <div>Total Cartons: <strong>@Model.Result.TotalCartons</strong></div>
            <div>Total Pallets: <strong>@Model.Result.TotalPallets</strong></div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function(){
            function postToController(url, data) {
                var form = document.createElement('form');
                form.method = 'post';
                form.action = url;
                for (var key in data) {
                    var input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = key;
                    input.value = data[key] ?? '';
                    form.appendChild(input);
                }
                document.body.appendChild(form);
                form.submit();
            }

            document.getElementById('executeControllerBtn').addEventListener('click', function(){
                var sectionId = document.getElementById('sectionSelect').value;
                var clientId = document.getElementById('clientSelect').value;
                if(!sectionId || !clientId){
                    alert('???? ????? ??????? ?????');
                    return;
                }
                postToController('/Query/ClientInSection', { sectionId: sectionId, clientId: clientId });
            });
        })();
    </script>
}