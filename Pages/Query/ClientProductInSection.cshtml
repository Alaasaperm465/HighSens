@page
@model QueryClientProductInSectionModel
@{
    ViewData["Title"] = "عميل+منتج في قسم";
}                                                                                       
<div class="container mt-3">
    <h3>مخزون عميل لمنتج داخل قسم</h3>

    <form method="get" id="queryGetForm" class="row g-2 align-items-end">
        <div class="col-auto">
            <label class="form-label">القسم</label>
            <select id="sectionSelect" name="SectionId" class="form-select">
                <option value="">-- اختر القسم --</option>
                @foreach(var s in Model.Sections)
                {
                    <option value="@s.Value" selected="@(Model.SectionId.HasValue && Model.SectionId.Value.ToString() == s.Value ? "selected" : null)">@s.Text</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label">العميل</label>
            <select id="clientSelect" name="ClientId" class="form-select">
                <option value="">-- اختر العميل --</option>
                @foreach(var c in Model.Clients)
                {
                    <option value="@c.Value" selected="@(Model.ClientId.HasValue && Model.ClientId.Value.ToString() == c.Value ? "selected" : null)">@c.Text</option>                              
                }
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label">المنتج</label>
            <select id="productSelect" name="ProductId" class="form-select">
                <option value="">-- اختر المنتج --</option>
                @foreach(var p in Model.Products)
                {
                    <option value="@p.Value" selected="@(Model.ProductId.HasValue && Model.ProductId.Value.ToString() == p.Value ? "selected" : null)">@p.Text</option>                          
                }
            </select>
        </div>
        <div class="col-auto d-flex gap-2">
            <button type="submit" class="btn btn-primary">حساب</button>
            <button type="button" class="btn btn-outline-success" id="executeControllerBtn">نفّذ الأكشن</button>
        </div>
        <div class="col-12 mt-2">
            <div asp-validation-summary="All" class="text-danger"></div>
        </div>
    </form>

    @if (Model.HasResult)
    {
        <div class="card mt-3 p-3">
            <div>SectionId: <strong>@Model.Result.SectionId</strong></div>
            <div>ClientId: <strong>@Model.Result.ClientId</strong></div>
            <div>ProductId: <strong>@Model.Result.ProductId</strong></div>
            <div>Cartons: <strong>@Model.Result.Cartons</strong></div>
            <div>Pallets: <strong>@Model.Result.Pallets</strong></div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function(){
            function postToController(url, data) {
                var form = document.createElement('form');
                form.method = 'post';
                form.action = url;
                for (var key in data) {
                    var input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = key;
                    input.value = data[key] ?? '';
                    form.appendChild(input);
                }
                document.body.appendChild(form);
                form.submit();
            }

            document.getElementById('executeControllerBtn').addEventListener('click', function(){
                var sectionId = document.getElementById('sectionSelect').value;
                var clientId = document.getElementById('clientSelect').value;
                var productId = document.getElementById('productSelect').value;
                if(!sectionId || !clientId || !productId){
                    alert('اختر القسم والعميل والمنتج أولاً');
                    return;
                }
                postToController('/Query/ClientProductInSection', { sectionId: sectionId, clientId: clientId, productId: productId });                                                               
            });
        })();
    </script>
}