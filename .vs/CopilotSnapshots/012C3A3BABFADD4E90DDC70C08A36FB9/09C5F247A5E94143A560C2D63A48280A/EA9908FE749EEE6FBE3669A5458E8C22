using Microsoft.AspNetCore.Mvc.RazorPages;
using Microsoft.AspNetCore.Mvc;
using InfraStructure.Context;
using System.Threading.Tasks;
using Microsoft.EntityFrameworkCore;
using Microsoft.AspNetCore.Mvc.Rendering;
using System.Linq;
using System.Collections.Generic;

public class QuerySectionTotalModel : PageModel
{
    private readonly DBContext _db;
    public QuerySectionTotalModel(DBContext db) => _db = db;

    [BindProperty(SupportsGet = true)]
    public int? SectionId { get; set; }

    public List<SelectListItem> Sections { get; set; } = new List<SelectListItem>();

    public SectionStockResult Result { get; set; }

    public bool HasResult { get; set; }

    public async Task OnGetAsync()
    {
        Sections = await _db.Sections
            .OrderBy(s => s.Name)
            .Select(s => new SelectListItem { Value = s.Id.ToString(), Text = s.Name })
            .ToListAsync();

        if (!SectionId.HasValue || SectionId <= 0)
        {
            // nothing to compute
            return;
        }

        var exists = await _db.Sections.AnyAsync(s => s.Id == SectionId.Value);
        if (!exists)
        {
            ModelState.AddModelError(string.Empty, "القسم غير موجود.");
            return;
        }

        var inboundCartons = await _db.InboundDetails
            .Where(d => d.SectionId == SectionId.Value)
            .SumAsync(d => (int?)d.Cartons) ?? 0;

        var inboundPallets = await _db.InboundDetails
            .Where(d => d.SectionId == SectionId.Value)
            .SumAsync(d => (int?)d.Pallets) ?? 0;

        var outboundCartons = await _db.OutboundDetails
            .Where(d => d.SectionId == SectionId.Value)
            .SumAsync(d => (int?)d.Cartons) ?? 0;

        var outboundPallets = await _db.OutboundDetails
            .Where(d => d.SectionId == SectionId.Value)
            .SumAsync(d => (int?)d.Pallets) ?? 0;

        Result = new SectionStockResult
        {
            SectionId = SectionId.Value,
            TotalCartons = inboundCartons - outboundCartons,
            TotalPallets = inboundPallets - outboundPallets
        };

        HasResult = true;
    }

    public class SectionStockResult
    {
        public int SectionId { get; set; }
        public int TotalCartons { get; set; }
        public int TotalPallets { get; set; }
    }
}