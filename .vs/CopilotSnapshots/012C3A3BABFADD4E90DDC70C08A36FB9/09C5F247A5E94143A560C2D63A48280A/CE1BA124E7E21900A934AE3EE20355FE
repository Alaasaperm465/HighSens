@page
@model QueryClientProductInSectionModel
@{
    ViewData["Title"] = "عميل+منتج في قسم";
}
<div class="container mt-3">
    <h3>مخزون عميل لمنتج داخل قسم</h3>

    <form method="get" class="row g-2 align-items-end">
        <div class="col-auto">
            <label class="form-label">Section Id</label>
            <input type="number" name="sectionId" value="@Model.SectionId" class="form-control" />
        </div>
        <div class="col-auto">
            <label class="form-label">Client Id</label>
            <input type="number" name="clientId" value="@Model.ClientId" class="form-control" />
        </div>
        <div class="col-auto">
            <label class="form-label">Product Id</label>
            <input type="number" name="productId" value="@Model.ProductId" class="form-control" />
        </div>
        <div class="col-auto">
            <button class="btn btn-primary">حساب</button>
        </div>
    </form>

    @if (Model.HasResult)
    {
        <div class="card mt-3 p-3">
            <div>SectionId: <strong>@Model.Result.SectionId</strong></div>
            <div>ClientId: <strong>@Model.Result.ClientId</strong></div>
            <div>ProductId: <strong>@Model.Result.ProductId</strong></div>
            <div>Cartons: <strong>@Model.Result.Cartons</strong></div>
            <div>Pallets: <strong>@Model.Result.Pallets</strong></div>
        </div>
    }
</div>