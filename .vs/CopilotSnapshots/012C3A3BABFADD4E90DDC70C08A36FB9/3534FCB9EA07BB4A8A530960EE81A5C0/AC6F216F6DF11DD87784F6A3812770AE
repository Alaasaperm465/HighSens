@model MVC.Controllers.ClientSectionDTO
@{
    ViewData["Title"] = "عميل في قسم";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-3">
    <h3>مخزون عميل داخل قسم</h3>

    <form method="post" class="row g-2 align-items-end" id="filterForm" onsubmit="return false;">
        <div class="col-auto">
            <label class="form-label">القسم</label>
            <select id="sectionSelect" name="sectionId" class="form-select">
                <option value="">-- اختر القسم --</option>
                @foreach(Microsoft.AspNetCore.Mvc.Rendering.SelectListItem s in ViewBag.Sections)
                {
                    <option value="@s.Value">@s.Text</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label">العميل</label>
            <select id="clientSelect" name="clientId" class="form-select">
                <option value="">-- اختر العميل --</option>
                @foreach(Microsoft.AspNetCore.Mvc.Rendering.SelectListItem c in ViewBag.Clients)
                {
                    <option value="@c.Value">@c.Text</option>
                }
            </select>
        </div>
    </form>

    <div class="d-flex gap-2 mt-3" id="actionsRow" style="display:none;">
        <button class="btn btn-outline-secondary" id="printBtn">طباعة</button>
        <button class="btn btn-outline-primary" id="downloadCsvBtn">تنزيل CSV</button>
    </div>

    <div id="detailContainer" class="mt-3"></div>

    @if (Model != null)
    {
        <div class="card mt-3 p-3">
            <div>SectionId: <strong>@Model.SectionId</strong></div>
            <div>ClientId: <strong>@Model.ClientId</strong></div>
            <div>Total Cartons: <strong>@Model.TotalCartons</strong></div>
            <div>Total Pallets: <strong>@Model.TotalPallets</strong></div>
        </div>
    }
</div>

@section Styles {
    <style>
        .negative { color: #c82333; font-weight: 600; }
        .zero { color: #856404; }
        @media print {
            body * { visibility: hidden; }
            #printArea, #printArea * { visibility: visible; }
            #printArea { position: absolute; left: 0; top: 0; width: 100%; }
        }
    </style>
}

@section Scripts {
    <script>
        (function(){
            const sectionSelect = document.getElementById('sectionSelect');
            const clientSelect = document.getElementById('clientSelect');
            const detailContainer = document.getElementById('detailContainer');
            const actionsRow = document.getElementById('actionsRow');
            const printBtn = document.getElementById('printBtn');
            const downloadCsvBtn = document.getElementById('downloadCsvBtn');

            let lastClientData = null; // store fetched client detail

            async function loadDetails() {
                const sectionId = sectionSelect.value;
                const clientId = clientSelect.value;
                detailContainer.innerHTML = '';
                actionsRow.style.display = 'none';
                lastClientData = null;
                if (!sectionId || !clientId) return;

                try {
                    const resp = await fetch(`/Query/SectionDetails?sectionId=${encodeURIComponent(sectionId)}`);
                    if (!resp.ok) throw new Error('Failed to load');
                    const data = await resp.json();

                    // find client
                    const client = data.find(c => c.clientId === parseInt(clientId, 10));
                    if (!client) {
                        detailContainer.innerHTML = '<div class="text-muted">لا توجد بيانات لهذا العميل في هذا القسم.</div>';
                        return;
                    }

                    lastClientData = client;
                    actionsRow.style.display = '';

                    // build html
                    let html = `
                        <div class="card shadow-sm p-3" id="printArea">
                            <div class="mb-2"><strong>العميل:</strong> ${escapeHtml(client.clientName)} </div>
                            <div class="mb-2"><strong>إجمالي كرتون:</strong> ${client.totalCartons} &nbsp; <strong>إجمالي بالات:</strong> ${client.totalPallets}</div>
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead><tr><th>المنتج</th><th class="text-end">كرتون</th><th class="text-end">بالت</th></tr></thead>
                                    <tbody>
                    `;

                    client.products.forEach(p => {
                        const cartonsClass = p.cartons < 0 ? 'negative' : (p.cartons === 0 ? 'zero' : '');
                        const palletsClass = p.pallets < 0 ? 'negative' : (p.pallets === 0 ? 'zero' : '');
                        html += `<tr><td>${escapeHtml(p.productName)}</td><td class="text-end ${cartonsClass}">${p.cartons}</td><td class="text-end ${palletsClass}">${p.pallets}</td></tr>`;
                    });

                    html += `</tbody></table></div></div>`;

                    detailContainer.innerHTML = html;
                } catch (e) {
                    console.error(e);
                    detailContainer.innerHTML = '<div class="text-danger">فشل تحميل البيانات.</div>';
                }
            }

            function escapeHtml(str){
                if(!str) return '';
                return str.replace(/[&<>"']/g, function(m){return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[m];});
            }

            sectionSelect.addEventListener('change', loadDetails);
            clientSelect.addEventListener('change', loadDetails);

            printBtn.addEventListener('click', function(){
                if (!lastClientData) return;
                const printWindow = window.open('', '_blank');
                const title = `مخزون العميل - ${lastClientData.clientName}`;
                const styles = `
                    <style>body{font-family:Arial,Helvetica,sans-serif;padding:20px} table{width:100%;border-collapse:collapse} th,td{padding:8px;border:1px solid #ddd} .negative{color:#c82333;font-weight:600} .zero{color:#856404}</style>`;
                let html = `<html><head><title>${title}</title>${styles}</head><body>`;
                html += `<h3>${escapeHtml(lastClientData.clientName)}</h3>`;
                html += `<p>اجمالي كرتون: ${lastClientData.totalCartons} &nbsp; اجمالي بالات: ${lastClientData.totalPallets}</p>`;
                html += '<table><thead><tr><th>المنتج</th><th class="text-end">كرتون</th><th class="text-end">بالت</th></tr></thead><tbody>';
                lastClientData.products.forEach(p => {
                    const cartonsClass = p.cartons < 0 ? 'negative' : (p.cartons === 0 ? 'zero' : '');
                    const palletsClass = p.pallets < 0 ? 'negative' : (p.pallets === 0 ? 'zero' : '');
                    html += `<tr><td>${escapeHtml(p.productName)}</td><td class="text-end ${cartonsClass}">${p.cartons}</td><td class="text-end ${palletsClass}">${p.pallets}</td></tr>`;
                });
                html += '</tbody></table>';
                html += '</body></html>';
                printWindow.document.write(html);
                printWindow.document.close();
                printWindow.focus();
                // Give time to render then print
                setTimeout(() => { printWindow.print(); printWindow.close(); }, 500);
            });

            downloadCsvBtn.addEventListener('click', function(){
                if(!lastClientData) return;
                const rows = [];
                rows.push(['Client', 'Product', 'Cartons', 'Pallets']);
                lastClientData.products.forEach(p => rows.push([lastClientData.clientName, p.productName, p.cartons, p.pallets]));
                const csv = rows.map(r => r.map(cell => `"${String(cell).replace(/"/g,'""')}"`).join(',')).join('\n');
                const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `client_${lastClientData.clientId}_section_${sectionSelect.value}.csv`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            });

            // Optionally preload if Model present
            (function(){
                const modelSection = '@(Model?.SectionId ?? 0)';
                const modelClient = '@(Model?.ClientId ?? 0)';
                if (modelSection && modelClient && modelSection !== '0' && modelClient !== '0') {
                    sectionSelect.value = modelSection;
                    clientSelect.value = modelClient;
                    loadDetails();
                }
            })();
        })();
    </script>
}
