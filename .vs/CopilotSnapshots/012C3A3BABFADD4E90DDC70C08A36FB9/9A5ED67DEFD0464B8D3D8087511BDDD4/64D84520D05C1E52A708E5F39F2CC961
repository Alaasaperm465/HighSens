@model MVC.Controllers.SectionStockDTO
@{
    ViewData["Title"] = "مجموع قسم";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm p-4">
        <h3 class="mb-4">تفصيل المخزون في القسم</h3>

        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-bold">القسم</label>
                <select id="sectionSelect" name="sectionId" class="form-select">
                    <option value="">-- اختر القسم --</option>
                    @foreach (Microsoft.AspNetCore.Mvc.Rendering.SelectListItem s in ViewBag.Sections)
                    {
                        <option value="@s.Value">@s.Text</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="button" onclick="loadSectionDetails()" class="btn btn-primary btn-lg" id="showBtn">عرض</button>
            </div>
        </div>

        <div class="d-flex gap-2 mt-3" id="actionsRow" style="display:none;">
            <button type="button" class="btn btn-outline-secondary" id="printBtn"><i class="bi bi-printer"></i> طباعة</button>
            <button type="button" class="btn btn-outline-primary" id="downloadCsvBtn"><i class="bi bi-download"></i> تنزيل CSV</button>
        </div>

        <div id="detailContainer" class="mt-4"></div>

        @if (Model != null)
        {
            <div class="card mt-3 p-3 shadow-sm">
                <div><strong>SectionId:</strong> @Model.SectionId</div>
                <div><strong>Total Cartons:</strong> @Model.TotalCartons</div>
                <div><strong>Total Pallets:</strong> @Model.TotalPallets</div>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .negative {
            color: #c82333;
            font-weight: 600;
        }

        .zero {
            color: #856404;
        }

        .client-row {
            cursor: pointer;
        }

        .product-block td {
            background-color: #f8f9fa;
        }

        @@media print {
            body * {
                visibility: hidden;
            }

            #printArea, #printArea * {
                visibility: visible;
            }

            #printArea {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
            }
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function(){
            (function(){
                const sectionSelect = document.getElementById('sectionSelect');
                const showBtn = document.getElementById('showBtn');
                const detailContainer = document.getElementById('detailContainer');
                const actionsRow = document.getElementById('actionsRow');
                const printBtn = document.getElementById('printBtn');
                const downloadCsvBtn = document.getElementById('downloadCsvBtn');
                let lastData = null;

                async function loadDetails() {
                    const sectionId = sectionSelect.value;
                    detailContainer.innerHTML = '<div class="text-center text-muted">جاري التحميل...</div>';
                    actionsRow.style.display = 'none';
                    lastData = null;
                    if (!sectionId) { detailContainer.innerHTML = ''; return; }

                    try {
                        const url = '@Url.Action("SectionDetails", "Query")' + '?sectionId=' + encodeURIComponent(sectionId);
                        const resp = await fetch(url, { credentials: 'same-origin' });
                        const contentType = resp.headers.get('content-type') || '';
                        if (!resp.ok || contentType.indexOf('application/json') === -1) {
                            if (resp.url && resp.url.toLowerCase().includes('/account/login')) { window.location.href = resp.url; return; }
                            throw new Error('الاستجابة ليست بصيغة JSON');
                        }
                        const data = await resp.json();
                        if (!Array.isArray(data) || data.length === 0) {
                            detailContainer.innerHTML = '<div class="text-muted">لا توجد بيانات لهذا القسم.</div>';
                            return;
                        }

                        lastData = data;
                        actionsRow.style.display = '';

                        let html = '<div class="card shadow-sm p-3" id="printArea">';
                        html += '<h5>تفصيل حسب العميل</h5>';
                        html += '<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>العميل</th><th class="text-end">إجمالي كرتون</th><th class="text-end">إجمالي بالات</th><th></th></tr></thead><tbody>';

                        data.forEach(client => {
                            html += `<tr class="client-row" data-client='${client.clientId}'>`;
                            html += `<td>${escapeHtml(client.clientName)}</td>`;
                            html += `<td class="text-end">${client.totalCartons}</td>`;
                            html += `<td class="text-end">${client.totalPallets}</td>`;
                            html += `<td class="text-end"><button class="btn btn-sm btn-link toggle-products" type="button">عرض المنتجات</button></td>`;
                            html += '</tr>';

                            html += `<tr class="product-block" data-client='${client.clientId}' style="display:none;"><td colspan="4">`;
                            html += '<div class="table-responsive"><table class="table mb-0"><thead><tr><th>المنتج</th><th class="text-end">كرتون</th><th class="text-end">بالت</th></tr></thead><tbody>';
                            client.products.forEach(p => {
                                const cartonsClass = p.cartons < 0 ? 'negative' : (p.cartons === 0 ? 'zero' : '');
                                const palletsClass = p.pallets < 0 ? 'negative' : (p.pallets === 0 ? 'zero' : '');
                                html += `<tr><td>${escapeHtml(p.productName)}</td><td class="text-end ${cartonsClass}">${p.cartons}</td><td class="text-end ${palletsClass}">${p.pallets}</td></tr>`;
                            });
                            html += '</tbody></table></div></td></tr>';
                        });

                        html += '</tbody></table></div></div>';
                        detailContainer.innerHTML = html;

                        document.querySelectorAll('.toggle-products').forEach(btn => {
                            btn.addEventListener('click', function(){
                                const tr = this.closest('tr');
                                const clientId = tr.getAttribute('data-client');
                                const block = document.querySelector(`.product-block[data-client="${clientId}"]`);
                                block.style.display = (block.style.display === 'none') ? '' : 'none';
                            });
                        });

                    } catch(e) {
                        console.error(e);
                        detailContainer.innerHTML = `<div class="text-danger">فشل تحميل البيانات: ${escapeHtml(e.message)}</div>`;
                    }
                }

                // expose globally as fallback
                window.loadSectionDetails = loadDetails;

                function escapeHtml(str){
                    if(!str) return '';
                    return String(str).replace(/[&<>"']/g, function(m){return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[m];});
                }

                showBtn.addEventListener('click', loadDetails);

                printBtn.addEventListener('click', function(){
                    if (!lastData) return;
                    const printWindow = window.open('', '_blank');
                    const title = `تفصيل قسم ${sectionSelect.options[sectionSelect.selectedIndex].text}`;
                    const styles = `<style>body{font-family:Arial,sans-serif;padding:20px} table{width:100%;border-collapse:collapse} th,td{padding:8px;border:1px solid #ddd} .negative{color:#c82333;font-weight:600} .zero{color:#856404}</style>`;
                    let html = `<html><head><title>${title}</title>${styles}</head><body><h3>${escapeHtml(title)}</h3>`;
                    lastData.forEach(client => {
                        html += `<h4>${escapeHtml(client.clientName)} - كرتون: ${client.totalCartons} - بالات: ${client.totalPallets}</h4>`;
                        html += '<table><thead><tr><th>المنتج</th><th class="text-end">كرتون</th><th class="text-end">بالت</th></tr></thead><tbody>';
                        client.products.forEach(p => {
                            html += `<tr><td>${escapeHtml(p.productName)}</td><td class="text-end">${p.cartons}</td><td class="text-end">${p.pallets}</td></tr>`;
                        });
                        html += '</tbody></table><br/>';
                    });
                    html += '</body></html>';
                    printWindow.document.write(html);
                    printWindow.document.close();
                    printWindow.focus();
                    setTimeout(()=>{printWindow.print(); printWindow.close();},500);
                });

                downloadCsvBtn.addEventListener('click', function(){
                    if(!lastData) return;
                    const rows = [];
                    rows.push(['Client','Product','Cartons','Pallets']);
                    lastData.forEach(client => {
                        client.products.forEach(p => rows.push([client.clientName, p.productName, p.cartons, p.pallets]));
                    });
                    const csv = rows.map(r=>r.map(cell=>`"${String(cell).replace(/"/g,'""')}"`).join(',')).join('\n');
                    const blob = new Blob([csv],{type:'text/csv;charset=utf-8;'});
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `section_${sectionSelect.value}_details.csv`;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    URL.revokeObjectURL(url);
                });

            })();
        });
    </script>
}
