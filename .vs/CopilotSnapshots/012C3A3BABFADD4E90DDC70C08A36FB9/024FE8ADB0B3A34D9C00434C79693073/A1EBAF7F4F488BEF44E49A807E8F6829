using System.Linq;
using System.Threading.Tasks;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using InfraStructure.Context;
//using Application.DTOs;
using MVC.ViewModels;

namespace MVC.Controllers
{
    public class QueryController : Controller
    {
        private readonly DBContext _db;

        public QueryController(DBContext db)
        {
            _db = db;
        }

        // 1) Total stock for a section (POST) - redirect to Razor Page GET with query param
        [HttpPost]
        public IActionResult SectionTotal(int sectionId)
        {
            return Redirect($"/Query/SectionTotal?SectionId={sectionId}");
        }

        // 2) Client in Section (POST) - redirect to Razor Page GET with query params
        [HttpPost]
        public IActionResult ClientInSection(int sectionId, int clientId)
        {
            return Redirect($"/Query/ClientInSection?SectionId={sectionId}&ClientId={clientId}");
        }

        // 3) Client + Product in Section (POST) - redirect to Razor Page GET with query params
        [HttpPost]
        public IActionResult ClientProductInSection(int sectionId, int clientId, int productId)
        {
            return Redirect($"/Query/ClientProductInSection?SectionId={sectionId}&ClientId={clientId}&ProductId={productId}");
        }
    }
}
