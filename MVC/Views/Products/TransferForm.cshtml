@model HighSens.Application.DTOs.Product.ProductTransferDto
@{
    ViewData["Title"] = "Product Transfer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-3">
    <h3>نقل منتجات بين أقسام</h3>
    <form asp-action="ProductTransfer" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-2">
            <div class="col-md-4">
                <label class="form-label">العميل</label>
                <select name="ClientId" class="form-select">
                    <option value="">-- اختر العميل --</option>
                    @foreach(var c in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Clients)
                    {
                        <option value="@c.Value">@c.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">المنتج</label>
                <select name="ProductId" class="form-select">
                    <option value="">-- اختر المنتج --</option>
                    @foreach(var p in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Products)
                    {
                        <option value="@p.Value">@p.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-4"></div>

            <div class="col-md-6 mt-2">
                <label class="form-label">من قسم</label>
                <select name="FromSectionId" class="form-select">
                    <option value="">-- اختر القسم --</option>
                    @foreach(var s in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Sections)
                    {
                        <option value="@s.Value">@s.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-6 mt-2">
                <label class="form-label">إلى قسم</label>
                <select name="ToSectionId" class="form-select">
                    <option value="">-- اختر القسم --</option>
                    @foreach(var s in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Sections)
                    {
                        <option value="@s.Value">@s.Text</option>
                    }
                </select>
            </div>

            <div class="col-md-3 mt-2">
                <label class="form-label">الكرتون</label>
                <input type="number" name="Cartons" class="form-control" min="0" />
            </div>
            <div class="col-md-3 mt-2">
                <label class="form-label">البالتات</label>
                <input type="number" name="Pallets" class="form-control" min="0" />
            </div>

            <div class="col-12 mt-3">
                <button class="btn btn-primary">تنفيذ النقل</button>
                <a class="btn btn-secondary" asp-action="Index" asp-controller="Stock">الغاء</a>
            </div>
        </div>
    </form>
</div>
